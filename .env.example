# Copy to .env and fill in.  `.env` is gitignored — never commit real keys.
#   cp .env.example .env

# --- NGC credentials ----------------------------------------------------------
# Generate at https://ngc.nvidia.com/setup/api-key  (username is literally "$oauthtoken")
NGC_API_KEY=

# --- Host paths (absolute) ----------------------------------------------------
# LOCAL_PROJECT_DIR is mounted into the TAO container at $TAO_PROJECT_DIR.
LOCAL_PROJECT_DIR=/home/as22cq/Projects/SyntheticDataGenerationModelTraining
TAO_PROJECT_DIR=/workspace/tao-experiments

# --- Dataset ------------------------------------------------------------------
# Raw Omniverse Replicator output (rgb/ + bounding_box_2d_tight/ per subdir).
RAW_DATA_DIR=data/raw
# KITTI-format dataset produced by scripts/02_convert_tfrecords.sh step 1.
KITTI_DATA_DIR=data/kitti
# Object class to detect (lowercase; must match KITTI label column 0).
TARGET_CLASS=palletjack
# Fraction of images held out for validation.
VAL_SPLIT=0.2
# Deterministic shuffling.
RANDOM_SEED=42

# --- Model / training ---------------------------------------------------------
# Pretrained backbone pulled from NGC in scripts/01_download_pretrained.sh
PRETRAINED_MODEL=nvidia/tao/pretrained_object_detection:resnet18
ARCH=resnet18
BATCH_SIZE=4
NUM_EPOCHS=80
LEARNING_RATE=5e-4
NUM_GPUS=1

# --- Container ----------------------------------------------------------------
TAO_DOCKER_IMAGE=nvcr.io/nvidia/tao/tao-toolkit:5.0.0-tf1.15.5
