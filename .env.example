# Copy to .env and adjust.  `.env` is gitignored.
#   cp .env.example .env

# --- Paths --------------------------------------------------------------------
# Absolute path to this project. Defaults to the notebook's parent directory.
LOCAL_PROJECT_DIR=/home/as22cq/Projects/SyntheticDataGenerationModelTraining
# Raw Omniverse Replicator output (rgb_*.png + bounding_box_2d_tight_*.npy).
RAW_DATA_DIR=data/raw
# KITTI-format dataset produced by step 4.2.
KITTI_DATA_DIR=data/kitti

# --- Dataset ------------------------------------------------------------------
# Object class to detect. Must match the semantic label in your Replicator scene,
# lowercase, and column 0 of the KITTI labels.
TARGET_CLASS=palletjack
# Fraction of images held out for validation.
VAL_SPLIT=0.2
# Deterministic shuffling and train/val split.
RANDOM_SEED=42
# Images are resized to this on conversion.
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720

# --- Model / training ---------------------------------------------------------
# torchvision resnet variant used as the FPN backbone: resnet18 | resnet34 | resnet50
BACKBONE=resnet18
# Measured optimum on the GB10: throughput plateaus at 16 and even 32 uses only
# ~15 GB of 130 GB. You stop gaining speed long before you run out of memory.
BATCH_SIZE=16
NUM_EPOCHS=20
# Standard Faster R-CNN recipe is lr=0.02 at batch 16. Scale linearly with BATCH_SIZE.
LEARNING_RATE=2e-2
WEIGHT_DECAY=5e-4
# DataLoader workers. Lower if workers get killed for lack of shared memory.
NUM_WORKERS=8
# Mixed precision — large speedup on Blackwell, minimal accuracy cost. 1 or 0.
USE_AMP=1
